# NEON RIFT server configuration.
# Copy to .env for docker-compose, or export these variables in your host.
# Bun does not load .env automatically for `bun run start`; use your process
# manager, Railway variables, or `docker compose --env-file .env up`.

# Port the Bun server listens on. Railway injects PORT automatically.
PORT=3000

# Bind address. 0.0.0.0 exposes LAN + public interfaces.
HOST=0.0.0.0

# production enables strict WebSocket origin checks and production logging.
NODE_ENV=production

# Exact public origin (scheme + host, no trailing slash). Recommended behind
# proxies that rewrite the Host header. Example: https://neon-rift.up.railway.app
PUBLIC_ORIGIN=

# Extra comma-separated origins allowed to open the WebSocket. Only needed for
# custom domains or separate front-end hosting. Example:
# ALLOWED_ORIGINS=https://neon-rift.example.com,https://staging.example.com
ALLOWED_ORIGINS=

# Never enable in production. Exposes POST /api/test/finish used only by the
# automated browser tests.
ENABLE_TEST_ENDPOINTS=0

# debug | info | warn | error | silent
LOG_LEVEL=info
